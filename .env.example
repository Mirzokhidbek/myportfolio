# Copy to .env and fill in the values (Next.js and the Prisma CLI both read it).

# SQLite database (path is relative to the prisma/ folder)
DATABASE_URL="file:./data/app.db"

# Signs login tokens. Use a long random string (at least 16 characters).
AUTH_JWT_SECRET=

# The account that signs up with this email becomes the admin.
ADMIN_EMAIL=

# Public URL of the site, used in the sitemap, robots.txt and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary, for image uploads in the admin panel
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=blog
